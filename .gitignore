toneforge/assets/uvr5/models/**/*.ckpt
toneforge/assets/uvr5/models/**/*.pth
toneforge/assets/uvr5/models/**/*.th

# Explicitly keep small bundled Ozone 12 ONNX models (< 7 MB) tracked
!toneforge/assets/ozone12/models/*.onnx
!toneforge/assets/models/bsrnn_realtime/*.onnx

