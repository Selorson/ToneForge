{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToneForge",
  "version": "0.1.0",
  "identifier": "com.toneforge.daw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui-svelte5-wgpu/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ToneForge — Hybrid DAW + AI Mastering & Stem Workstation",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  }
}
