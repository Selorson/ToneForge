{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToneForge",
  "version": "0.1.0",
  "identifier": "com.toneforge.daw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui-svelte5-wgpu/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ToneForge Studio — Hybrid DAW + AI Mastering & Stem Workstation",
        "width": 1600,
        "height": 940,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0E1B1D"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

