{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToneForge Studio",
  "version": "0.1.3",
  "identifier": "com.toneforge.studio",
  "build": {
    "frontendDist": "../../ui-svelte5-wgpu/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui-svelte5-wgpu run dev",
    "beforeBuildCommand": "npm --prefix ../ui-svelte5-wgpu run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ToneForge Studio — 120 FPS WebGPU Mastering & Stem Workstation",
        "width": 1600,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0E1B1D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERDE3RDFDOTczRUFCOUEKUldTYXF6NlhISDNSZmZGYUVFcFoxbHNWbitzOW1CVTMyQWNTeHdrMFhxVG93eXBwZDNCOHdBaVAK",
      "endpoints": [
        "https://github.com/Selorson/ToneForge-Release/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../assets/proq4": "assets/proq4",
      "../../assets/soothe3": "assets/soothe3",
      "../../assets/flstudio26": "assets/flstudio26",
      "../../assets/param_tables": "assets/param_tables",
      "../../assets/ozone12/params": "assets/ozone12/params",
      "../../assets/ozone12/target_curves": "assets/ozone12/target_curves",
      "../../assets/ozone12/target_curves_catalog.json": "assets/ozone12/target_curves_catalog.json",
      "../../assets/ozone12/assistant_presets": "assets/ozone12/assistant_presets",
      "../../assets/ozone12/global_presets": "assets/ozone12/global_presets",
      "../../assets/uvr5/mdx_c_configs": "assets/uvr5/mdx_c_configs",
      "../../assets/uvr5/vr_network": "assets/uvr5/vr_network",
      "../../assets/uvr5/models/MDX_Net_Models/model_data": "assets/uvr5/models/MDX_Net_Models/model_data",
      "../../assets/uvr5/models/Demucs_Models/model_data": "assets/uvr5/models/Demucs_Models/model_data",
      "../../assets/uvr5/models/VR_Models/model_data": "assets/uvr5/models/VR_Models/model_data",
      "../../assets/cleanroom_asset_manifest.json": "assets/cleanroom_asset_manifest.json",
      "../../huong-dan-toneforge.html": "huong-dan-toneforge.html"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "ToneForge Studio — Hybrid DAW + AI Mastering & Stem Workstation"
  }
}
