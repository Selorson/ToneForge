{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToneForge Studio",
  "version": "0.1.0",
  "identifier": "com.toneforge.studio",
  "build": {
    "frontendDist": "../../ui-svelte5-wgpu/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../ui-svelte5-wgpu run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ToneForge Studio — 120 FPS WebGPU Mastering & Stem Workstation",
        "width": 1600,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0E1B1D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "ToneForge Studio — Hybrid DAW + AI Mastering & Stem Workstation"
  }
}
